[Unit]
Description=runlet - GitHub Actions runner scheduler
Documentation=https://github.com/Jungley8/runlet
After=network-online.target
Wants=network-online.target
# A broken config exits at once. Without a start limit systemd retries it every
# RestartSec forever and the journal fills with the same error.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/runlet serve
EnvironmentFile=-%h/.config/runlet/env
Restart=on-failure
RestartSec=5s
# Lanes outlive the supervisor by design, so shutdown must not wait for them.
# The default 90 s ended in SIGKILL, which skipped deregistration.
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Deliberately not set:
#   PrivateDevices=, ProtectKernelModules=  the user manager cannot apply them
#                                           and the exec fails with 218/CAPABILITIES
#   ProtectSystem=strict                    lanes write under $HOME; a read-only
#                                           hierarchy breaks every job
#   CapabilityBoundingSet=                  a user unit cannot change it
#   MemoryDenyWriteExecute=                 the runner is .NET and JITs

[Install]
WantedBy=default.target
